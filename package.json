{
  "name": "appCheckList",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "clean": "cd android && ./gradlew clean && cd .. && npx react-native run-android",
    "clean-all": "rm -rf node_modules && npm install && cd android && ./gradlew clean && cd ..",
    "release": "npx react-native build-android --mode=release",
    "apkrelease": "cd android && ./gradlew assembleRelease && cd ..",
    "svgTransformer": "npx @svgr/cli --native --icon --ext tsx --out-dir ./src/assets ./src/assets",
    "pods": "cd ios && NO_FLIPPER=1 pod install && cd .."
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.80.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "react": "19.1.0",
    "react-native": "0.80.0",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-paper": "^5.11.2",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.1",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-toast-message": "^2.1.7",
    "react-native-vector-icons": "^10.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.0.0",
    "@react-native-community/cli-platform-android": "19.0.0",
    "@react-native-community/cli-platform-ios": "19.0.0",
    "@react-native/babel-preset": "0.80.0",
    "@react-native/eslint-config": "0.80.0",
    "@react-native/metro-config": "0.80.0",
    "@svgr/cli": "^8.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-native-vector-icons": "^6.4.17",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "0.77.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "19.1.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
